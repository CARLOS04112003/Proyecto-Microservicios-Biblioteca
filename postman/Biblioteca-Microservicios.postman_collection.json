{
  "info": {
    "name": "Biblioteca - Microservicios",
    "description": "Flujo completo de demostración para 5 microservicios: autenticación, catálogo, préstamos, reservas y reseñas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@biblioteca.pe\", \"password\": \"Admin123*\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Login usuario demo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('memberToken', pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"usuario@biblioteca.pe\", \"password\": \"Member123*\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "3. Listar libros",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.content && data.content.length) pm.collectionVariables.set('bookId', data.content[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/books?size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ],
          "query": [
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "4. Crear libro (admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('bookId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"isbn\": \"DEMO-2026-001\", \"title\": \"Arquitectura de Microservicios\", \"author\": \"Equipo del curso\", \"category\": \"Tecnología\", \"description\": \"Libro creado para la demostración.\", \"totalCopies\": 2}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books"
          ]
        }
      }
    },
    {
      "name": "5. Crear reserva (usuario)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": \"{{bookId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('reservationId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Mis reservas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservations/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservations",
            "me"
          ]
        }
      }
    },
    {
      "name": "7. Cancelar reserva",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservations",
            "{{reservationId}}",
            "cancel"
          ]
        }
      }
    },
    {
      "name": "8. Crear reseña (usuario)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reviews",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"rating\": 5,\n  \"comment\": \"Excelente libro para la demostración de microservicios.\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('reviewId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Resumen de reseñas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/book/{{bookId}}/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "book",
            "{{bookId}}",
            "summary"
          ]
        }
      }
    },
    {
      "name": "10. Prestar libro (usuario)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/loans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"loanDays\": 14\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('loanId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Mis préstamos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/loans/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans",
            "me"
          ]
        }
      }
    },
    {
      "name": "12. Devolver libro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/loans/{{loanId}}/return",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "loans",
            "{{loanId}}",
            "return"
          ]
        }
      }
    }
  ]
}
